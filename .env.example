APP_NAME=ForgeQueue
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

POSTGRES_USER=forgequeue
POSTGRES_PASSWORD=forgequeue_dev
POSTGRES_DB=forgequeue
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_JOBS_STREAM="forgequeue:jobs"
REDIS_DEAD_LETTER_STREAM="forgequeue:dead"
REDIS_WORKER_GROUP="forgequeue-workers"
REDIS_SOCKET_TIMEOUT_SECONDS=5
REDIS_WORKER_BLOCK_MS=1000

WORKER_RECOVERY_MIN_IDLE_MS=60000
WORKER_RECOVERY_BATCH_SIZE=10
WORKER_RECOVERY_POLL_SECONDS=30
WORKER_LEASE_DURATION_SECONDS=60
WORKER_HEARTBEAT_INTERVAL_SECONDS=15

RETRY_DISPATCHER_BATCH_SIZE=100
RETRY_DISPATCHER_POLL_SECONDS=1

DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
