APP_NAME=ForgeQueue
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

POSTGRES_USER=forgequeue
POSTGRES_PASSWORD=forgequeue_dev
